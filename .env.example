MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
SESSION_SECRET=
# Shared password for the demo accounts created on a fresh database (12+ characters).
# Without this line Compose uses clubspacetest123; an empty value skips demo data.
DEMO_ACCOUNT_PASSWORD=clubspacetest123

# Optional Google sign-in: both values from the Google Cloud OAuth client.
# Leave them out to keep Google sign-in off. Never commit them.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Only when rebuilding somewhere other than c3322-pg19.cs.hku.hk:
# APP_ORIGIN must be exactly the address you open in the browser (scheme, host
# and any port), because the API rejects requests from other origins. The
# default is https://c3322-pg19.cs.hku.hk; an https:// origin is served with a
# self-signed certificate, an http:// one over plain HTTP.
# APP_ORIGIN=http://localhost:8080
# WEB_PORT and WEB_HTTPS_PORT are the host ports (defaults 80 and 443).
# WEB_PORT=8080
# WEB_HTTPS_PORT=8443
