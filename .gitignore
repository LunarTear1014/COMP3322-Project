# Local configuration and database files
.env
.env.*
!.env.example
/.first-member-password
/.first-member.pending
/.starter-accounts-ready

# Runtime files
node_modules/
*.log
.DS_Store

# Server-generated TLS certificate and key
/certs/

# Local cover uploads
backend-beta/data/

# Agent session transcripts and cross-bot logs (local only; they contain
# full conversations and personal details)
docs/sessions/
**/docs/sessions/
.agent-sync/
**/.agent-sync/

# Google OAuth client credentials downloaded from Google Cloud Console.
# The app reads GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET from .env instead.
client_secret_*.json
